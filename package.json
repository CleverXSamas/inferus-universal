{
  "name": "inferus-universal",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/server/index.js",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "tsc -p tsconfig.test.json && node --test --test-isolation=none work/test-build/test/*.test.js",
    "test:statistics": "node --import tsx test/statistical/dice.ts",
    "bot": "tsx bot/index.ts",
    "bot:register": "tsx bot/index.ts --register",
    "start:bot": "node dist-server/bot/index.js",
    "test:browser": "playwright test",
    "format": "prettier --write \"{server,packages,src,bot,test}/**/*.{ts,tsx}\" playwright.config.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "@xyflow/react": "latest",
    "discord.js": "^14.28.0",
    "mysql2": "^3.24.6",
    "react": "latest",
    "react-dom": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
